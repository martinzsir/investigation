{
  "schema_version": 2,
  "_note": "类型层（Link Types）：只声明关系是什么——端点对象（from_obj/to_obj）与边属性值类型。物化 SQL 一律在 bindings.json 的 link_bindings。端点外键列名以 bindings 的 build_sql 输出为准。",
  "links": [
    {
      "name": "transfers",
      "title": "转账关系",
      "from_obj": "account",
      "to_obj": "account",
      "properties": {"amount": "decimal", "date": "date"},
      "endpoints": {
        "from": {"col": "from_account_id", "ref": {"object": "account", "key": "account_id", "name": "raw_name"}},
        "to": {"col": "to_account_id", "ref": {"object": "account", "key": "account_id", "name": "raw_name"}},
        "extra": ["from_account", "to_account", "amount", "date"]
      }
    },
    {
      "name": "calls_to",
      "title": "通话关系",
      "from_obj": "person",
      "to_obj": "person",
      "properties": {},
      "endpoints": {
        "from": {"col": "from_person", "ref": {"object": "person", "key": "person_id", "name": "raw_name"}},
        "to": {"col": "to_person", "ref": {"object": "person", "key": "person_id", "name": "raw_name"}},
        "extra": ["call_id"]
      }
    },
    {
      "name": "owns",
      "title": "持有账户",
      "from_obj": "account",
      "to_obj": "person",
      "properties": {},
      "endpoints": {
        "from": {"col": "owner_raw"},
        "to": {"col": "account_id", "ref": {"object": "account", "key": "account_id", "name": "raw_name"}}
      }
    },
    {
      "name": "involved_in",
      "title": "中标参与",
      "from_obj": "org",
      "to_obj": "bid_project",
      "properties": {},
      "endpoints": {
        "from": {"col": "org_id", "ref": {"object": "org", "key": "org_id", "name": "raw_name"}},
        "to": {"col": "project_id", "ref": {"object": "bid_project", "key": "project_id", "name": "title"}}
      }
    },
    {
      "name": "co_located",
      "title": "同地点出现",
      "from_obj": "person",
      "to_obj": "person",
      "properties": {"location": "string", "date": "date"},
      "endpoints": {
        "from": {"col": "person_1", "ref": {"object": "person", "key": "person_id", "name": "raw_name"}},
        "to": {"col": "person_2", "ref": {"object": "person", "key": "person_id", "name": "raw_name"}},
        "extra": ["location", "date"]
      }
    },
    {
      "name": "time_window",
      "title": "时间窗碰撞",
      "from_obj": "bid_project",
      "to_obj": "transaction",
      "jian": "反间",
      "jian_source": "银行流水(过桥)",
      "properties": {"amount": "decimal", "offset_days": "integer"},
      "endpoints": {
        "from": {"col": "title"},
        "to": {"col": "owner_raw"},
        "extra": ["offset_days"]
      }
    },
    {
      "name": "decision_for",
      "title": "决定针对线索",
      "from_obj": "decision",
      "to_obj": "clue",
      "runtime": true,
      "_note": "运行期链接：Action 执行器创建 obj_decision 时同步写入 lnk_decision_for，不参与编译期物化；端点列约定 decision_id/clue_id。",
      "properties": {}
    },
    {
      "name": "tipoff_targets_person",
      "title": "举报针对人员",
      "from_obj": "tipoff",
      "to_obj": "person",
      "properties": {"tip_type": "string", "submit_date": "date"},
      "endpoints": {
        "from": {"col": "tipoff_id", "ref": {"object": "tipoff", "key": "tipoff_id", "name": "title"}},
        "to": {"col": "person_id", "ref": {"object": "person", "key": "person_id", "name": "raw_name"}},
        "extra": ["target_raw", "tip_type", "submit_date"]
      }
    },
    {
      "name": "tipoff_from_reporter",
      "title": "举报来源指向",
      "from_obj": "tipoff",
      "to_obj": "person",
      "properties": {"tip_type": "string", "submit_date": "date"},
      "endpoints": {
        "from": {"col": "tipoff_id", "ref": {"object": "tipoff", "key": "tipoff_id", "name": "title"}},
        "to": {"col": "person_id", "ref": {"object": "person", "key": "person_id", "name": "raw_name"}},
        "extra": ["reporter_raw", "tip_type", "submit_date"]
      },
      "_note": "REQ-P-032：举报人归一。reporter_raw 常为匿名，LEFT JOIN 未命中则 person_id 为空（边不成立但不丢材料）。"
    },
    {
      "name": "osint_mentions",
      "title": "OSINT提及主体",
      "from_obj": "osint_article",
      "to_obj": "person",
      "properties": {"source_name": "string", "pub_date": "date"}
    }
  ]
}
