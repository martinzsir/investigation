{
  "schema_version": 2,
  "_note": "类型层（Object Types）：只声明对象是什么——主键、kind(entity 实体型/event 事件型)、身份属性、带值类型的属性集。数据来源/清洗/物化 SQL 一律在 bindings.json。值类型：string/integer/decimal/date/boolean。",
  "objects": [
    {
      "name": "person",
      "title": "自然人",
      "pk": "person_id",
      "key": {"column": "person_id", "strategy": "proxy", "prefix": "person"},
      "kind": "entity",
      "name_property": "raw_name",
      "properties": {
        "raw_name": "string",
        "id_card": "string"
      }
    },
    {
      "name": "org",
      "title": "组织",
      "pk": "org_id",
      "key": {"column": "org_id", "strategy": "proxy", "prefix": "org"},
      "kind": "entity",
      "name_property": "raw_name",
      "properties": {
        "raw_name": "string",
        "legal_rep": "string",
        "status": "string",
        "relation": "string"
      },
      "metadata_props": [
        "status"
      ]
    },
    {
      "name": "account",
      "title": "账户",
      "pk": "account_id",
      "key": {"column": "account_id", "strategy": "proxy", "prefix": "account"},
      "kind": "entity",
      "name_property": "raw_name",
      "properties": {
        "raw_name": "string"
      }
    },
    {
      "name": "person_identity",
      "title": "人员信息",
      "pk": "identity_id",
      "key": {"column": "identity_id", "strategy": "proxy", "prefix": "identity"},
      "kind": "entity",
      "name_property": "raw_name",
      "_note": "数据接入全流程演示对象：人员建档信息承载 5 个数据元落点（DE_IDCARD/DE_PHONE/DE_GENDER/DE_ID_TYPE/DE_CASE_TYPE；金额/日期/币种落点在 transaction）。源表「人员信息」缺失时 binding optional 跳过；身份证 clean_rule(despace)/手机(strip_cc+digits_only) 经 prop_de_clean 在 py 层自动挂接。",
      "properties": {
        "raw_name": "string",
        "id_card": {"data_element": "DE_IDCARD"},
        "phone": {"data_element": "DE_PHONE"},
        "gender": {"data_element": "DE_GENDER"},
        "id_type": {"data_element": "DE_ID_TYPE"},
        "case_type": {"data_element": "DE_CASE_TYPE"}
      }
    },
    {
      "name": "transaction",
      "title": "交易",
      "pk": "txn_id",
      "key": {"column": "txn_id", "strategy": "proxy", "prefix": "txn"},
      "kind": "event",
      "name_property": "from_raw",
      "properties": {
        "from_raw": "string",
        "to_raw": "string",
        "amount": {"type": "decimal", "data_element": "DE_AMOUNT"},
        "currency": {"data_element": "DE_CURRENCY"},
        "date": {"data_element": "DE_DATE"}
      }
    },
    {
      "name": "call",
      "title": "通话",
      "pk": "call_id",
      "key": {"column": "call_id", "strategy": "proxy", "prefix": "call"},
      "kind": "event",
      "name_property": "caller_raw",
      "properties": {
        "caller_raw": "string",
        "callee_raw": "string",
        "date": {"data_element": "DE_DATE"},
        "times": "integer"
      }
    },
    {
      "name": "trackpoint",
      "title": "轨迹点",
      "pk": "track_id",
      "key": {"column": "track_id", "strategy": "proxy", "prefix": "track"},
      "kind": "event",
      "name_property": "person_raw",
      "properties": {
        "person_raw": "string",
        "location": "string",
        "date": {"data_element": "DE_DATE"}
      }
    },
    {
      "name": "location",
      "title": "地点",
      "pk": "location_id",
      "key": {"column": "location_id", "strategy": "proxy", "prefix": "loc"},
      "kind": "entity",
      "name_property": "std_address",
      "_note": "维度实体：从事件反向物化，非新数据源。坐标挂实体不挂事件（同源事件共享坐标）；代理键按 std_address 值分配——同标准地址天然归并为同一节点。坐标统一 GCJ-02。",
      "properties": {
        "std_address": "string",
        "raw_address": "string",
        "province": "string",
        "prefecture": "string",
        "county": "string",
        "township": "string",
        "admin_code": "string",
        "lat": "decimal",
        "lng": "decimal",
        "coord_sys": "string",
        "geocode_source": "string",
        "geocode_confidence": "decimal",
        "geocoded_at": "string"
      },
      "metadata_props": ["geocode_source", "geocode_confidence", "geocoded_at"]
    },
    {
      "name": "bid_project",
      "title": "招投标项目",
      "pk": "project_id",
      "key": {"column": "project_id", "strategy": "proxy", "prefix": "project"},
      "kind": "entity",
      "name_property": "title",
      "properties": {
        "title": "string",
        "winner_raw": "string",
        "pub_date": {"data_element": "DE_DATE"},
        "leader": "string"
      },
      "metadata_props": [
        "title"
      ]
    },
    {
      "name": "clue",
      "title": "线索",
      "pk": "clue_id",
      "key": {"column": "clue_id", "strategy": "natural"},
      "kind": "entity",
      "name_property": "clue_id",
      "_note_naming": "name_property 等于 pk（自引用）：线索无自然名，代理键即标识",
      "properties": {
        "status": "string",
        "last_operator": "string",
        "note": "string",
        "updated_at": "string"
      },
      "metadata_props": [
        "status",
        "last_operator",
        "note",
        "updated_at"
      ]
    },
    {
      "name": "decision",
      "title": "处置决定",
      "pk": "decision_id",
      "key": {"column": "decision_id", "strategy": "natural"},
      "kind": "entity",
      "name_property": "decision_id",
      "runtime": true,
      "_note": "运行期对象：不由编译器从 L2 物化。属性声明即 DDL——Action 执行器 file 动作时由 ensure_runtime_tables 建表（obj_decision / lnk_decision_for），列序与 INSERT 对齐。",
      "properties": {
        "decision_type": "enum",
        "clue_id": "string",
        "legal_basis": "string",
        "operator": "string",
        "note": "string",
        "created_at": "string",
        "metadata": "json"
      },
      "enum_values": {
        "decision_type": [
          "立案",
          "不予立案",
          "移送管辖",
          "补充侦查",
          "撤销"
        ]
      },
      "metadata_props": [
        "decision_type",
        "clue_id",
        "legal_basis",
        "operator",
        "note",
        "created_at",
        "metadata"
      ]
    },
    {
      "name": "tipoff",
      "title": "举报线索（内间）",
      "pk": "tipoff_id",
      "key": {"column": "tipoff_id", "strategy": "proxy", "prefix": "tipoff"},
      "kind": "event",
      "name_property": "title",
      "_note": "五间映射：内间（内部线索/举报材料）。五间由 packs/wujian 提供。",
      "properties": {
        "title": "string",
        "submit_date": {"data_element": "DE_DATE"},
        "target_raw": "string",
        "reporter_raw": "string",
        "content_raw": "string"
      },
      "metadata_props": [
        "title",
        "submit_date",
        "content_raw"
      ]
    },
    {
      "name": "osint_article",
      "title": "公开OSINT文章（死间）",
      "pk": "article_id",
      "key": {"column": "article_id", "strategy": "proxy", "prefix": "article"},
      "kind": "event",
      "name_property": "raw_name",
      "_note": "五间映射：死间（公开OSINT交叉验证）。五间由 packs/wujian 提供。",
      "properties": {
        "raw_name": "string",
        "info_text": "string",
        "pub_date": {"data_element": "DE_DATE"},
        "source_name": "string",
        "crawled_at": "timestamp",
        "retention_days": "duration_days"
      },
      "metadata_props": [
        "info_text",
        "pub_date",
        "source_name",
        "crawled_at",
        "retention_days"
      ]
    },
    {
      "name": "image_evidence",
      "title": "图像证据（人验通过）",
      "pk": "image_evidence_id",
      "key": {"column": "image_evidence_id", "strategy": "natural"},
      "kind": "entity",
      "name_property": "image_evidence_id",
      "runtime": true,
      "_note": "P8 运行期对象：不由编译器从 L2 物化。VLM 草案永远不直接产生本对象——仅经人验 Action（verify_image）由 ActionExecutor 创建；模型名/prompt 版本/模型分为独立字段（模型分不参与确定性计分，仅供排序参考）。挂主体经 lnk_image_for_person/org/bid_project（按 subject_type 写对应表）。列定义即 DDL，ensure_runtime_tables 建表。",
      "properties": {
        "image_uri": "string",
        "model": "string",
        "prompt_version": "string",
        "model_score": "decimal",
        "title": "string",
        "detail": "string",
        "severity": "string",
        "verifier": "string",
        "verify_conclusion": "string",
        "subject_type": "string",
        "draft_id": "string",
        "created_at": "string"
      },
      "metadata_props": [
        "image_uri",
        "model",
        "prompt_version",
        "model_score",
        "title",
        "detail",
        "severity",
        "verifier",
        "verify_conclusion",
        "subject_type",
        "draft_id",
        "created_at"
      ]
    }
  ]
}
