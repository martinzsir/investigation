{
  "schema_version": 2,
  "_note": "类型层（Object Types）：只声明对象是什么——主键、kind(entity 实体型/event 事件型)、身份属性、带值类型的属性集。数据来源/清洗/物化 SQL 一律在 bindings.json。值类型：string/integer/decimal/date/boolean。",
  "objects": [
    {
      "name": "person",
      "title": "自然人",
      "pk": "person_id",
      "kind": "entity",
      "name_property": "raw_name",
      "properties": {"raw_name": "string"}
    },
    {
      "name": "org",
      "title": "组织",
      "pk": "org_id",
      "kind": "entity",
      "name_property": "raw_name",
      "properties": {
        "raw_name": "string",
        "legal_rep": "string",
        "status": "string",
        "relation": "string"
      }
    },
    {
      "name": "account",
      "title": "账户",
      "pk": "account_id",
      "kind": "entity",
      "name_property": "raw_name",
      "properties": {"raw_name": "string"}
    },
    {
      "name": "transaction",
      "title": "交易",
      "pk": "txn_id",
      "kind": "event",
      "name_property": "from_raw",
      "properties": {
        "from_raw": "string",
        "to_raw": "string",
        "amount": "decimal",
        "date": "date"
      }
    },
    {
      "name": "call",
      "title": "通话",
      "pk": "call_id",
      "kind": "event",
      "name_property": "caller_raw",
      "properties": {
        "caller_raw": "string",
        "callee_raw": "string",
        "date": "date",
        "times": "integer"
      }
    },
    {
      "name": "trackpoint",
      "title": "轨迹点",
      "pk": "track_id",
      "kind": "event",
      "name_property": "person_raw",
      "properties": {
        "person_raw": "string",
        "location": "string",
        "date": "date"
      }
    },
    {
      "name": "bid_project",
      "title": "招投标项目",
      "pk": "project_id",
      "kind": "entity",
      "name_property": "title",
      "properties": {
        "title": "string",
        "winner_raw": "string",
        "pub_date": "date",
        "leader": "string"
      }
    },
    {
      "name": "clue",
      "title": "线索",
      "pk": "clue_id",
      "kind": "entity",
      "name_property": "clue_id",
      "_note_naming": "name_property 等于 pk（自引用）：线索无自然名，代理键即标识",
      "properties": {
        "status": "string",
        "last_operator": "string",
        "note": "string",
        "updated_at": "string"
      }
    },
    {
      "name": "decision",
      "title": "处置决定",
      "pk": "decision_id",
      "kind": "entity",
      "name_property": "decision_id",
      "runtime": true,
      "_note": "运行期对象：不由编译器从 L2 物化。属性声明即 DDL——Action 执行器 file 动作时由 ensure_runtime_tables 建表（obj_decision / lnk_decision_for），列序与 INSERT 对齐。",
      "properties": {
        "decision_type": "enum",
        "clue_id": "string",
        "legal_basis": "string",
        "operator": "string",
        "note": "string",
        "created_at": "string",
        "metadata": "json"
      },
      "enum_values": {
        "decision_type": ["立案", "不予立案", "移送管辖", "补充侦查", "撤销"]
      }
    },
    {
      "name": "tipoff",
      "title": "举报线索（内间）",
      "pk": "tipoff_id",
      "kind": "event",
      "name_property": "title",
      "_note": "五间映射：内间（内部线索/举报材料）。接入后 jian_cross_level 内间自动从缺口变命中。",
      "properties": {
        "title": "string",
        "submit_date": "date",
        "target_raw": "string",
        "reporter_raw": "string",
        "content_raw": "string"
      }
    },
    {
      "name": "osint_article",
      "title": "公开OSINT文章（死间）",
      "pk": "article_id",
      "kind": "event",
      "name_property": "raw_name",
      "_note": "五间映射：死间（公开OSINT交叉验证）。原死间仅靠工商信息，新增后多一条公开渠道。",
      "properties": {
        "raw_name": "string",
        "info_text": "string",
        "pub_date": "date",
        "source_name": "string",
        "crawled_at": "timestamp",
        "retention_days": "duration_days"
      }
    }
  ]
}
