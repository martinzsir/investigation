{
  "schema_version": 2,
  "actions": [
    {
      "name": "verify",
      "title": "开始查证",
      "target_status": "查证中",
      "derive": "reverse_reach",
      "parameters": [],
      "requires_role": "any",
      "terminal": false,
      "side_effects": ["set_clue_status"],
      "description": "标记查证中（AI/正兵均可执行）"
    },
    {
      "name": "reset",
      "title": "退回待查",
      "target_status": "待查",
      "derive": "reverse_reach",
      "parameters": [],
      "requires_role": "any",
      "terminal": false,
      "side_effects": ["set_clue_status"],
      "description": "重开/回退待查"
    },
    {
      "name": "exclude",
      "title": "排除线索",
      "target_status": "已排除",
      "derive": "reverse_reach",
      "parameters": [
        {"name": "reason", "type": "string", "required": true, "description": "排除理由（写入审计链，可追溯）"}
      ],
      "requires_role": "any",
      "terminal": false,
      "side_effects": ["set_clue_status"],
      "description": "排除必须给理由"
    },
    {
      "name": "confirm",
      "title": "固证",
      "target_status": "已固证",
      "derive": "reverse_reach",
      "only_from": ["查证中"],
      "parameters": [],
      "requires_role": "any",
      "terminal": false,
      "side_effects": ["set_clue_status"],
      "description": "经查证成立，形成稳定证据（D1：待查态不可直接固证，须先查证中）"
    },
    {
      "name": "file",
      "title": "立案",
      "target_status": "已立案",
      "derive": "reverse_reach",
      "parameters": [
        {"name": "legal_basis", "type": "string", "required": true, "description": "法定依据：案号/审批文号"}
      ],
      "requires_role": "human",
      "terminal": true,
      "side_effects": ["set_clue_status", "create_decision"],
      "description": "受控终态：仅已固证可迁移、须法定依据、仅具名正兵；副作用创建 obj_decision 决策对象"
    },
    {
      "name": "review_merge",
      "title": "实体裁决-确认合并",
      "target_status": "待查",
      "parameters": [
        {"name": "candidate_id", "type": "string", "required": true, "description": "待复核候选 entity_id"}
      ],
      "requires_role": "human",
      "terminal": false,
      "side_effects": ["merge_entity", "create_decision"],
      "description": "W-021：人工确认合并 needs_review 实体候选；落 state.review_decision，不产版本"
    },
    {
      "name": "review_reject",
      "title": "实体裁决-驳回",
      "target_status": "待查",
      "parameters": [
        {"name": "candidate_id", "type": "string", "required": true, "description": "待复核候选 entity_id"},
        {"name": "reason", "type": "string", "required": true, "description": "驳回理由"}
      ],
      "requires_role": "human",
      "terminal": false,
      "side_effects": ["dismiss_review", "create_decision"],
      "description": "W-021：人工驳回实体候选（不合并）；驳回后不再入队"
    },
    {
      "name": "verify_image",
      "title": "图像核验通过（人验）",
      "target_status": "已固证",
      "derive": "reverse_reach",
      "only_from": ["查证中"],
      "parameters": [
        {"name": "image_uri", "type": "string", "required": true, "description": "图像文件 URI（已入卷）"},
        {"name": "model", "type": "string", "required": true, "description": "VLM 模型名（独立字段）"},
        {"name": "prompt_version", "type": "string", "required": true, "description": "prompt 版本（独立字段）"},
        {"name": "model_score", "type": "string", "required": false, "description": "模型分（独立字段，仅供排序，不参与确定性计分）"},
        {"name": "subject_type", "type": "string", "required": true, "description": "挂接主体类型 person/org/bid_project"},
        {"name": "subject_id", "type": "string", "required": true, "description": "挂接主体主键"},
        {"name": "verify_conclusion", "type": "string", "required": true, "description": "人工核验结论（比对原件的事实陈述）"},
        {"name": "draft_id", "type": "string", "required": false, "description": "来源 VLM 草案提案 ID（溯源）"}
      ],
      "requires_role": "human",
      "terminal": false,
      "side_effects": ["set_clue_status", "create_image_evidence"],
      "description": "P8 人验闸门：正兵比对原件确认 VLM 草案成立后执行；线索固证 + ActionExecutor 创建 obj_image_evidence 并按 subject_type 写 lnk_image_for_person/org/bid_project；模型输出不绕过本动作不能成证据"
    }
  ]
}
