        "person",
        "account",
        "org",
        "bid_project",
        "transfers",
        "calls_to",
        "owns",
        "involved_in",
        "co_located"
      ],
      "produces_dims": [
        "relation"
      ],
      "mode": "deterministic",
      "enabled": true,
      "params_schema": {
        "target_subject": {
          "type": "string",
          "required": true,
          "description": "目标主体（raw_name 或代理键）",
          "auto_from": {
            "source": "focus_subjects",
            "rank_by": "evidence_count",
            "max": 5,
            "object_types": [
              "person",
              "org",
              "account"
            ]
          }
        },
        "target_type": {
          "type": "string",
          "description": "auto/person/account/org/bid_project，同名歧义时显式消歧"
        },
        "depth": {
          "type": "integer",
          "description": "邻域跳数 1-3，缺省 2"
        },
        "edge_kinds": {
          "type": "string",
          "description": "all/fund/contact/org 边类别收窄，缺省 all"
        }
      },
      "scope": {
        "reads": [
          "person",
          "account",
          "org",
          "bid_project",
          "transfers",
          "calls_to",
          "owns",
          "involved_in",
          "co_located"
