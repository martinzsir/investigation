        },
        "target_type_b": {
          "type": "string",
          "description": "subject_b 实体类型，同名歧义时消歧；缺省 auto"
        }
      },
      "scope": {
        "reads": [
          "person",
          "account",
          "org",
          "bid_project",
          "transfers",
          "calls_to",
          "owns",
          "involved_in",
          "co_located"
        ]
      },
      "handler": "impl:common_neighbors_lens",
      "description": "看两个人之间有没有共同的账户、单位或联系人"
    },
