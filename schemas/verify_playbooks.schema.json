{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verify_playbooks.schema.json",
  "title": "Ontology Verify Playbooks (schema_version=1)",
  "description": "核查剧本：规则/假设命中后的确定性复跑函数或外部调取清单",
  "type": "object",
  "required": ["schema_version", "playbooks"],
  "properties": {
    "schema_version": {"const": 1},
    "_note": {"type": "string"},
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "channel", "match", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "channel": {"enum": ["function", "external"]},
          "match": {
            "type": "object",
            "properties": {
              "rule_id": {"type": "string"},
              "assumption": {
                "oneOf": [
                  {"type": "string"},
                  {"type": "array", "items": {"type": "string"}}
                ]
              }
            },
            "additionalProperties": true
          },
          "function": {"type": "string"},
          "fallback_function": {"type": "string"},
          "external": {
            "type": "object",
            "properties": {
              "target": {"type": "string"},
              "material": {"type": "string"}
            },
            "additionalProperties": true
          },
          "text": {"type": "string", "minLength": 1},
          "falsification": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
